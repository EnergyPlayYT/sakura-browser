{
  "name": "sakura-browser",
  "productName": "Sakura",
  "version": "1.0.69",
  "description": "Eigener Browser im Sakura-Stil mit Werbeblocker, Privatmodus und Synchronisation",
  "main": "main.js",
  "author": "Ali",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always",
    "test": "node test/run-all.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.ali.sakura",
    "productName": "Sakura",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload-ui.js",
      "preload-page.js",
      "lib/**",
      "ui/**",
      "pages/**",
      "assets/**",
      "backgrounds/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sakura",
      "artifactName": "Sakura-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Webseiten",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Sakura-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "synopsis": "Browser im japanischen Sakura-Stil",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ]
    },
    "appImage": {
      "artifactName": "Sakura-${version}.${ext}"
    },
    "appx": {
      "identityName": "EnergyPlay.SakuraBrowser",
      "applicationId": "Sakura",
      "displayName": "Sakura Browser",
      "publisherDisplayName": "EnergyPlay",
      "backgroundColor": "#1C1A33",
      "languages": [
        "de-DE",
        "en-US"
      ],
      "artifactName": "Sakura-Store-${version}.${ext}"
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.6.2",
    "qrcode-generator": "^1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EnergyPlayYT/sakura-browser.git"
  }
}
